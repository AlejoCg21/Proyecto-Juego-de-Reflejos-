public class Jugador extends Entidad{
    private int bloqueosExitosos;
    
    //Método constructor - clase hija
    public Jugador(String nombre, int vidas, int nivel) {
        super(nombre, vidas, nivel);
        this.bloqueosExitosos = 0;
    }
    //Getter
    public int getBloqueosExitosos() {
        return bloqueosExitosos;
    }

    //Métodos
    public boolean bloquear(String respuesta, String correcta ) {
        if (respuesta.equalsIgnorecase(correcta)) {
            bloqueosExitosos++;
            return true;
        }
        return false;
    }
    public void perderVida(int daño) {
        vidas -= daño;
        if(vidas <= 0) {
            vidas = 0;
        }
    }


    @Override
    public void acciones() {
        System.out.println(nombre + "bloqueó el rayo.");
    }
    public void mostrarEstado() {
        System.out.println(nombre + " | Vidas: " + vidas + " | Nivel: " + nivel + " | Bloqueos exitosos: " + bloqueosExitosos);
    }


}
