public class Entidad {
    //Atributos
    protected String nombre;
    protected int vidas;
    protected int nivel;

    //Método constructor
    public Entidad(String nombre, int vidas, int nivel) {
        this.nombre = nombre;
        this.vidas = vidas;
        this.nivel = nivel;
    }

    //Getters y setters
    public String getNombre() {
        return nombre;
    }
    public void setNombre(String nombre) {
        this.nombre = nombre;
    }


    public int getVidas() {
        return vidas;
    }
    public void setVidas(int vidas) {
        this.vidas = vidas;
    }


    public int getNivel() {
        return nivel;
    }
    public void setNivel(int nivel) {
        this.nivel = nivel;
    }


    //Métodos
    public void acciones() {
        System.out.println("La entidad " + nombre + " realiza una acción");
    }

    public void mostrarEstado() {
        System.out.println(nombre + " tiene " + vidas + " vidas y se encuentra en el nivel: " + nivel);
    }

}
